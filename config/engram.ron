{
    "basic": (
        font_size: 15,
        ui_density: "normal",
        confirm_destructive_actions: true,
        safe_start: true,
    ),

    "deep": (
        db_v2: false,
        sticky_notes: false,
        timeline_v2: false,
        coh2b: false,
    ),

    "modules": Modules(
        enabled: [
            "file_tree",
            "editor",
            "cockpit",
        ],
    ),

    "providers": (
        llm_bridge: false,
        auth_providers: false,
    ),

    "theme": Theme(
        background: "#000000",
        foreground: "#FF00FF",
        accent_primary: "#FF00FF",
        accent_secondary: "#7B00FF",
        font_editor: "Georgia",
        font_size: 16,
        font_ui: "FiraSans",
        font_ui_size: 13,
        cursor: "#FF00FF",
        border_color: "#7B00FF",
        border_width: 2,
    ),

    "theme_expert": ThemeExpert(
        selection_background: "#FFD700",
        selection_foreground: "#000000",
        bold_color: "#9B59B6",
        italic_color: "#FF55FF",
        highlight_background: "#FF8C00",
        highlight_foreground: "#000000",
        heading_h1: "#FF00FF",
        heading_h2: "#CC00FF",
        heading_h3: "#9900FF",
        heading_h4: "#6600FF",
        heading_h5: "#3300FF",
        heading_h6: "#7B00FF",
        wikilink_valid: "#FF00FF",
        wikilink_orphan: "#FF4444",
        wikilink_bracket_opacity: 10,
        border_glow: true,
        border_width: 2,
        border_color: "#7B00FF",
    ),

    "editor": Editor(
        font_editor: "Georgia",
        font_size: 15,
        column_width: 72,
        typewriter_mode: false,
        smart_typography: true,
        language: "fr",
        wikilink_autocomplete: true,
        snippet_prefix: ";",
        line_numbers: false,
        highlight_current_line: true,
        autosave_minutes: 5,
        auto_close_pairs: true,
    ),

    "editor_expert": EditorVomi(
        cursor_thickness: 2.0,
        cursor_blink_ms: 500,
        cursor_color: "",
        line_height: 1.6,
        paragraph_spacing: 14.0,
        editor_padding: 40.0,
        syntax_highlight_buffer_lines: 10,
        heading_h1_scale: 1.6,
        heading_h2_scale: 1.4,
        heading_h3_scale: 1.25,
        heading_h4_scale: 1.15,
        heading_h5_scale: 1.05,
        heading_h6_scale: 1.0,
        heading_h1: "",
        heading_h2: "",
        heading_h3: "",
        heading_h4: "",
        heading_h5: "",
        heading_h6: "",
        foreground: "",
        inline_code_foreground: "",
        inline_code_background: "",
        code_block_foreground: "",
        code_block_background: "",
        blockquote_color: "",
        blockquote_border: "",
        wikilink_valid: "",
        wikilink_orphan: "",
        tag_color: "",
        frontmatter_color: "",
        comment_prefix: "%",
        comment_color: "",
        markers_color: "",
        current_line_background: "",
        selection_background: "",
        search_highlight_background: "",
        search_current_background: "",
        zoom_min_pt: 10.0,
        zoom_max_pt: 48.0,
        zoom_scroll_step: 0.5,
        french_quotes: true,
        auto_emdash: true,
        auto_ellipsis: true,
        auto_nbsp: true,
        wikilink_bracket_opacity: 15,
        wikilink_autocomplete_min_chars: 1,
        wikilink_autocomplete_max_results: 8,
        goal_reached_color: "",
        stats_debounce_ms: 200,
        status_bar_color: "",
        focus_show_status_bar: true,
        focus_minimal_status: true,
        typewriter_position: 0.4,
        self_write_silence_secs: 2,
    ),

    "file_tree": FileTree(
        default_width: 280,
        show_word_counts: true,
        show_status_indicators: true,
        show_symlink_icons: true,
        font_size: 13,
        reopen_last_project: true,
    ),

    "file_tree_expert": FileTreeVomi(
        notify_debounce_ms: 500,
        scan_parallelism: 4,
        extra_extensions: [],
        exclude_dirs: [],
        indent_size: 16,
        row_height: 22,
        folder_color: "#aa00ff",
        symlink_color: "",
        en_cours_symlink_color: "#ff55ff",
        goal_pending_color: "",
        goal_reached_color: "",
        stats_unit: "words",
        abbreviate_counts: true,
        abbreviate_threshold: 1000,
    ),

    "backup": BackupConfig(
        enabled: true,
        interval_minutes: 30,
        keep_days: 30,
        format: "tar.gz",
        destination: "",
        auto_export_path: "",
    ),

    "claude_terminal": ClaudeTerminalConfig(
        provider: Claude,
        command: "claude",
        args: "--print --output-format json --no-input --max-turns 1",
        auth_mode: Subscription,
        api_key: None,
    ),
}
